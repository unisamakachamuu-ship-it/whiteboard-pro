# ===========================================================================
# Configuration template — copy this to .env and fill in what you need.
# .env is in .gitignore; never commit real credentials.
#
# Nothing here is required to run the app locally — every integration stays
# dormant and says so plainly until configured. Fill in only what you want.
# ===========================================================================

# ---------------------------------------------------------------------------
# Google Workspace OAuth (Calendar · Docs · Drive · Gmail · Tasks)
#
# The redirect URI below must match EXACTLY what is registered in the console
# under Credentials → your OAuth client → Authorised redirect URIs.
# Exactly means: same scheme, same host, same port, same path, no trailing
# slash. "localhost" and "127.0.0.1" are different origins to Google.
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Google Keep API — leave this OFF on a personal @gmail.com account.
#
# keep.googleapis.com is a Google Workspace *enterprise* service. It returns
# 403 PERMISSION_DENIED for consumer accounts no matter what is enabled in the
# Cloud console, and asking for a scope the account cannot be granted risks
# the whole consent screen — which would take Drive, Docs, Gmail and Calendar
# down with it.
#
# On a personal account use the Keep section of the Workspace panel instead;
# it signs in with an App Password and works.
#
# Set to 1 only on a Google Workspace account, then reconnect Google.
# ---------------------------------------------------------------------------

GOOGLE_ENABLE_KEEP=

# ---------------------------------------------------------------------------
# Email automation (assignment, @mention, completion, invitations)
#
# THESE ARE OPTIONAL. If your Google account is connected above, mail already
# goes out through the Gmail API using the gmail.send scope that connection
# already holds — no App Password, no 2-Step Verification, nothing to set here.
#
# SMTP is the fallback for a deployment with no Google connection. It needs a
# Gmail App Password, not your account password:
#   https://myaccount.google.com/apppasswords
#
# With neither route available, every notification is logged to the console
# and the UI says so rather than pretending it sent.
# ---------------------------------------------------------------------------

SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=

# ---------------------------------------------------------------------------
# Firebase identity bridge — makes the Workspace sign-in above the ONLY
# Google sign-in anyone needs (no separate Firebase popup/consent screen).
#
# 1. Firebase console -> Project settings -> Service accounts
# 2. "Generate new private key" -> save the downloaded file as
#    data/firebase-service-account.json (already in .gitignore)
# 3. Leave FIREBASE_SERVICE_ACCOUNT unset — that's the default path — or
#    point it somewhere else if you'd rather keep the key outside data/.
#
# Optional: without this, Workspace (Drive/Docs/Gmail/Calendar) still works
# exactly the same; only live sync and board sharing need it, and they say
# plainly that it's missing rather than failing silently.
# ---------------------------------------------------------------------------

FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Flask session signing key.
#
# Left blank, the server generates one on first run and persists it to
# data/.secret_key (make sure that path is on a volume that survives
# restarts). Set it explicitly if you deploy to more than one machine or
# replica — they must share the same value or sessions will not carry
# between them.
# ---------------------------------------------------------------------------

SECRET_KEY=

# ---------------------------------------------------------------------------
# Production hardening (all optional; sane defaults if unset)
# ---------------------------------------------------------------------------

# Comma-separated list of allowed CORS origins, e.g.
#   CORS_ORIGINS=https://boards.example.com,https://app.example.com
# Left unset, every origin is allowed (fine for a single self-hosted
# instance behind its own domain; tighten it if that's not your setup).
CORS_ORIGINS=

# Set to 1 to run Flask's own dev server (`python app.py`) with the
# interactive debugger. Never set this to 1 behind a public URL — it lets
# anyone who can reach an error page execute code on the server. Under
# gunicorn (the Docker image's default) this variable has no effect, since
# gunicorn never runs the debug dev-server code path at all.
FLASK_DEBUG=0
